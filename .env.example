# Public URL of the site, used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Lead form ----
# Where submissions are stored (JSON Lines). Must be on a persistent, writable disk.
LEADS_STORE_PATH=.data/leads.jsonl
# Notification provider: console | webhook | resend
LEADS_NOTIFY_PROVIDER=console
# Address that receives new-enquiry notifications (defaults to site.config.ts contact.email).
LEADS_NOTIFY_TO=
# Sender address for the "resend" provider (must be a verified domain).
LEADS_NOTIFY_FROM=
# For LEADS_NOTIFY_PROVIDER=resend
RESEND_API_KEY=
# For LEADS_NOTIFY_PROVIDER=webhook (receives a JSON POST, e.g. Zapier, Make, Slack, your CRM)
LEADS_WEBHOOK_URL=
# Rate limit: max submissions per IP per window
LEADS_RATE_LIMIT_MAX=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=600

# ---- Analytics (loaded only after the visitor accepts non-essential cookies) ----
# Script URL of your analytics provider, e.g. https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_SRC=
# Domain / site ID passed to the analytics script as data-domain
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# ---- Optional content feeds ----
# JSON feed for the News page (same shape as src/content/news.json). Falls back to the local file.
NEWS_FEED_URL=
# JSON endpoint for MF Research (same shape as src/content/funds.json). Falls back to the local file.
RESEARCH_API_URL=
